# Supabase project (Project Settings → API). The secret key is server-only:
# never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public address of the portal, used in email links.
APP_URL=http://localhost:3000

# Shared secret for the daily notification job (Vercel sends it automatically).
CRON_SECRET=

# Email sending via Resend (https://resend.com). Leave blank to disable emails.
RESEND_API_KEY=
EMAIL_FROM="Montagu Square Day Nursery <portal@your-domain.co.uk>"
