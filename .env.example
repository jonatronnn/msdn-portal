# Supabase project (Project Settings → API). The secret key is server-only:
# never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public address of the portal, used in email links.
APP_URL=http://localhost:3000

# Encryption key for staff bank details: run `openssl rand -base64 32`.
# Keep a copy somewhere safe; without it stored bank details can't be read.
BANK_DETAILS_KEY=

# Email sending via Resend (https://resend.com), used for the Important
# information form. Leave blank to disable emails.
RESEND_API_KEY=
EMAIL_FROM="Montagu Square Day Nursery <portal@your-domain.co.uk>"
